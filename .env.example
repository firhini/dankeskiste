# Absender, z. B. "Dankeskiste <hallo@dankeskiste.de>"
MAIL_FROM=
# Hierhin gehen Bestell- und Anfrage-Benachrichtigungen
OWNER_EMAIL=
IMAGE_API_PROVIDER=                        # optional
